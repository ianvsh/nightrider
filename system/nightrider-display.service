[Unit]
Description=Data logger touchscreen (5" DSI, 800x480)
After=nightrider.service
Wants=nightrider.service

[Service]
User=@USER@
Group=@USER@
SupplementaryGroups=video input audio
WorkingDirectory=@HOME@/nightrider
# Detach the text console from the screen so it can't draw over the dashboard
# (the + runs these as root); it comes back when this service stops.
ExecStartPre=+/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $v/name && echo 0 > $v/bind; done; true'
ExecStopPost=+/bin/sh -c 'for v in /sys/class/vtconsole/vtcon*; do grep -q "frame buffer" $v/name && echo 1 > $v/bind; done; true'
# .venv = system packages + faster-whisper (speech for the Claude page)
ExecStart=@HOME@/nightrider/.venv/bin/python @HOME@/nightrider/display.py
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
# 1 = temperatures in °F
Environment=NIGHTRIDER_DISPLAY_F=0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
