[Unit]
Description=Spotify player for the touchscreen (spotify_player in a detached tmux session)
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=ian
Group=ian
SupplementaryGroups=audio
WorkingDirectory=/home/ian
# spotify_player is a terminal app; tmux gives it a terminal nobody has to look at.
# See it with: tmux attach -t spotify   (detach: ctrl-b d)
Type=forking
# Wait for internet first: started offline, it gets stuck waiting for a login.
ExecStartPre=/usr/local/sbin/spotify-wait-net
TimeoutStartSec=infinity
ExecStart=/usr/bin/tmux new-session -d -s spotify -x 120 -y 40 /home/ian/.local/bin/spotify_player
ExecStop=/usr/bin/tmux kill-session -t spotify
Environment=TERM=xterm-256color
Restart=always
RestartSec=10
# A crash loop backs off 10 s -> 10 min: every start is a burst of Web API calls
# on Ian's app, and too many got it blocked for 21 hours (2026-11-15).
RestartSteps=6
RestartMaxDelaySec=600

[Install]
WantedBy=multi-user.target
