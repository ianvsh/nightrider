[Unit]
Description=Data logger (DME -> SQLite, served over Wi-Fi and Bluetooth)
After=bluetooth.service network.target
Wants=bluetooth.service

[Service]
User=ian
Group=ian
SupplementaryGroups=dialout bluetooth
WorkingDirectory=/home/ian/datalogger
# Bluetooth can start soft-blocked; the + runs this line as root
ExecStartPre=+-/usr/sbin/rfkill unblock bluetooth
ExecStart=/usr/bin/python3 /home/ian/datalogger/logger.py
Environment=DATALOGGER_DB=/var/lib/datalogger/log.db
Environment=DATALOGGER_HZ=10
Environment=DATALOGGER_HTTP_PORT=80
Environment=PYTHONUNBUFFERED=1
# Uncomment if a wideband O2 gauge is wired to the DME (aem, innovate, ...)
#Environment=GOLDY_WIDEBAND=aem
StateDirectory=datalogger
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
